#!/usr/bin/env bash
# =====================================================
# -----------------------------------------------------
# Reload, Select, or Randomly Select the wallpaper and colorscheme
#    Jason Bradberry (2025,2026)
# -----------------------------------------------------
# =====================================================

mthd="$1"
from_cron="$2"
cache_file="$HOME/.cache/current_wallpaper"
rasi_file="$HOME/.cache/current_wallpaper.rasi"
color_file="$HOME/.cache/wal/colors.sh"
pic_folder="$HOME/Pictures/Backgrounds"
notify_icon="/usr/share/icons/Tela-circle-dracula-dark/symbolic/apps/"
notify_icon+="preferences-desktop-wallpaper-symbolic.svg"
get_session="$HOME/.config/.scripts/ut-session"
wall_extra="$HOME/.config/.scripts/ut-wall-extra"
script_name=$(basename "$0")
SESSION_ENV="$HOME/.cache/cron-session.env"

# Create a cache file if none exists
if [ ! -f "$cache_file" ]; then
    echo "$pic_folder/default.png" >"$cache_file"
fi

# Create a rasi file if none exists
if [ ! -f "$rasi_file" ]; then
    echo "* { current-image: url(\"$pic_folder/default.png\", height); }" \
        >"$rasi_file"
fi

# -----------------------------------------------------
# Discover the current Wayland Compositor and if this is from cronie
# -----------------------------------------------------
#
if [[ "$mthd" == "--file" ]]; then
    pic_file="$from_cron"
    from_cron=""
fi

if [[ -n $from_cron ]]; then
    printf 'UT-WALLPAPER_______________________________cron\n'
    if [[ -f "$SESSION_ENV" ]]; then
        # shellcheck source=/home/moosicmaan/.cache/cron-session.env
        source "$SESSION_ENV"
    else
        printf 'ENV file needed by cron not found.\nRun ut-save-env.\n'
        printf 'Running ut-save-env may help. Exiting...\n\n'
        exit 1
    fi
else
    printf 'UT-WALLPAPER___________________________________\n'
fi

date

if cdesk=$("$get_session"); then
    if [[ -n $from_cron && "$cdesk" != "$from_cron" ]]; then
        printf 'The current session found = \"%s\": This run is for %s.\n' \
            "$cdesk" "$from_cron"
        printf 'If this is in error:\n\tIs this session in settings?\n'
        printf '\tRunning ut-save-env may fix some things.\nExiting %s...\n\n' \
            "$script_name"
        exit 1
    fi
else
    printf 'The session \"%s\" was not found.\n' "$cdesk"
    "$cdesk" "$script_name"
    printf 'If this is in error:\n\tIs this session in settings?\n'
    printf '\tRunning ut-save-env may fix some things.\nExiting %s...\n\n' \
        "$script_name"
    exit 1
fi

if ! $wall_extra "$cdesk"; then
    printf '!Error finding special processing for \"%n\" - Continuing...\n' \
        "$cdesk"
fi

# -----------------------------------------------------
# Load wallpaper from .cache of last session --init
# Select wallpaper with rofi                 --select
# Use the file that was sent                 --file
# Select a random wallpaper from pics folder --random
# -----------------------------------------------------
case $mthd in
"--init")
    cwall=$(cat "$cache_file") >/dev/null 2>&1
    wal -q -i "$cwall"
    ;;
"--random")
    wal -q -i "$pic_folder/" >/dev/null 2>&1
    ;;
"--select")
    selected=$(
        find "$pic_folder" -maxdepth 1 -type f \
            \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*webd" \
            -o -iname "*.png" -o -iname "*.gif" -o -iname "*.mp4" \) \
            -print0 |
            sort -zR |
            while IFS= read -r -d '' file; do
                printf '%s\0icon\x1f%s\n' "$(basename "$file")" "$file"
            done |
            rofi -dmenu -replace \
                -config ~/.config/rofi/config-wall.rasi \
                -p " > "
    )
    if [ ! "$selected" ]; then
        echo "No wallpaper selected"
        exit 0
    fi
    wal -q -i "$pic_folder/$selected" >/dev/null 2>&1
    ;;
"--file")
    if [[ -f "$pic_file" ]]; then
        wal -q -i "$pic_file" >/dev/null 2>&1
    else
        printf 'Error finding the image path \"%s\"\nExiting - %s' \
            "$pic_file" "$script_name"
        exit 1
    fi
    ;;
*)
    printf '!Not sure what to do with \"%s\". Setting random wallpaper...\n' \
        "$mthd"
    printf 'Usage is \"%s [--random|--init|--select|--file <file>]\"\n' \
        "$script_name"
    wal -q -i "$pic_folder/" >/dev/null 2>&1
    ;;
esac

# -----------------------------------------------------
# Process current pywal color scheme
# -----------------------------------------------------
# Acquire wallpaper name from pywal
# shellcheck source=/home/moosicmaan/.cache/wal/colors.sh
source "$color_file"
printf 'Wallpaper from pywal: %s\n' "$wallpaper"

# Save pywal into .cache files
echo "$wallpaper" >"$cache_file"
echo "* { current-image: url(\"$wallpaper\", height); }" >"$rasi_file"

# Reload status bar with new colors
"$HOME"/.config/.scripts/wb-launch "$cdesk"

# -----------------------------------------------------
# Apply wallpaper
# -----------------------------------------------------
transition_type="random"
# transition_type="none"
printf ':: Applying wallpaper with %s transition...' \
    "$transition_type"
awww img "$wallpaper" \
    --transition-type=$transition_type
awww clear-cache

# -----------------------------------------------------
# Send notification
# -----------------------------------------------------
if [ "$mthd" == "--init" ]; then
    echo ":: Init"
else
    newwall=$(basename "$wallpaper")
    sleep 1
    if [[ $from_cron ]]; then
        cron="via crontab"
    fi
    notify-send --icon=$notify_icon "Colors and Wallpaper" \
        "Updated for $cdesk $cron\nfrom image \"$newwall\""
fi

printf 'DONE - %s\n%s\n\n' "$script_name" "$(date)"
