#!/usr/bin/env bash
# =====================================================
# -----------------------------------------------------
# Reload, Select, or Randomly Select the wallpaper and colorscheme
#    Jason Bradberry (2025,2026)
# -----------------------------------------------------
# =====================================================

# Cache file for holding the current wallpaper
cache_file="$HOME/.cache/current_wallpaper"
rasi_file="$HOME/.cache/current_wallpaper.rasi"
pic_folder="$HOME/Pictures/Backgrounds"
notify_icon="/usr/share/icons/Tela-circle-dracula-dark/symbolic/apps/preferences-desktop-wallpaper-symbolic.svg"
method="$1"
from_cron="$2"
script_name=$(basename "$0")

# -----------------------------------------------------
# Discover the current Wayland Compositor and if this is from cronie
# -----------------------------------------------------
if [[ -n $from_cron ]]; then
    printf '\nUT-WALLPAPER_______________________________cron\n'
    date
    cdesk=$(/home/moosicmaan/.config/.scripts/ut-session cron)
    if [[ "$cdesk" == "$from_cron" ]]; then
        case $cdesk in
        hypr)
            # APPROVED for cron
            echo "$cdesk APPOVED for cronie processing"
            SESSION_ENV="/tmp/cron-session.env"
            if [[ -f "$SESSION_ENV" ]]; then
                # shellcheck source=/tmp/cron-session.env
                source "$SESSION_ENV"
            fi
            ;;
        sway | niri | dwl)
            # DISAPPROVED for cron
            echo "$cdesk NOT appoved for cronie processing"
            echo "Check $script_name if this is unexpected. Exiting..."
            exit 1
            ;;
        *)
            echo "$cdesk not recognized"
            echo "Approve/discpprove in $script_name, Exiting..."
            exit 1
            ;;
        esac
    else
        # Uncommend to let everything through that gives $from_cron
        # ----
        # if [[ "$cdesk" == "" ]]; then
        #     echo "No desktop session found"
        #     echo "Debug in $script_name, Continuing..."
        # else
        # ----
        printf '%s: This run is for %s.\nRunning ut-save-env may fix some things.\nExiting...\n' "$cdesk" "$from_cron"
        exit 1
        # ----
        # fi
        # ----
    fi
else
    cdesk=$(/home/moosicmaan/.config/.scripts/ut-session)
fi

# -----------------------------------------------------
# Apply special processing pertaining to wallpapern, if needed
# -----------------------------------------------------
case "$cdesk" in
hypr)
    echo "---special hypr processing---"
    echo "---        none           ---"
    ;;
dwl)
    echo "---special dwl processing---"
    # DWL starts without a wallpaper server, so start one if needed
    wall_server="awww-daemon"

    # Start the background daemon if needed
    if ! pidof "$wall_server"; then
        awww-daemon &
        sleep 1
        echo "$wall_server has been started"
        notify-send --icon="$notify_icon" "Wallpaper daemon:" "started $wall_server"
    fi
    ;;
sway)
    echo "---special sway processing---"
    echo "---        none           ---"
    ;;
niri)
    echo "---special niri processing---"
    # DWL starts without a wallpaper server, so start one if needed:
    wall_server="awww-daemon"

    # Start the background daemon if needed
    if ! pidof "$wall_server"; then
        awww-daemon &
        sleep 1
        echo "$wall_server has been started"
        notify-send --icon="$notify_icon" "Wallpaper daemon:" "started $wall_server"
    fi
    # Start the notify-send daemon if needed
    if ! pidof dunst; then
        dunst &
        sleep 1
        echo "dunst has been started"
        notify-send --icon="$notify_icon" "notify-send daemon:" "started dunst"
    fi
    ;;
nf)
    echo "From $script_name:"
    printf 'The desktop session was not recognizable: %s!=%s
    \rDebug in ut-session or run ut-save-env.\nExiting...' \
        "$cdesk" "$from_cron"
    exit 1
    ;;
*)
    # Still try - probably just testing a new WC/WM
    echo "---special ???? processing---"
    echo "---     Compositor NF     ---"
    # printf 'Error occurred in script %s: Compositor not found
    #     DESKTOP_SESSION not recognizable: %s
    #     There is not a waybar config for this session.
    #     Exiting...\n' \
    #     "$script_name" "$cdesk"
    # exit 1
    ;;
esac

# -----------------------------------------------------
# Create cache file if none exists
# -----------------------------------------------------
if [ ! -f "$cache_file" ]; then
    echo "$pic_folder/default.png" >"$cache_file"
fi

# -----------------------------------------------------
# Create rasi file if not exists
# -----------------------------------------------------
if [ ! -f "$rasi_file" ]; then
    echo "* { current-image: url(\"$pic_folder/default.png\", height); }" >"$rasi_file"
fi

# -----------------------------------------------------
# Load wallpaper from .cache of last session
# -----------------------------------------------------
case $method in
"--init")
    cwall=$(cat "$cache_file") >/dev/null 2>&1
    echo "Debug in --init: cwall = $cwall"
    wal -q -i "$cwall"
    ;;

# -----------------------------------------------------
# Select wallpaper with rofi
# -----------------------------------------------------
"--select")
    selected=$(find "$pic_folder" \
        -type f \( -iname "*.jpg" \
        -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.gif" -o -iname "*.mp4" \) \
        -exec basename {} \; | sort -R | while read -r rfile; do
        echo -en "$rfile\x00icon\x1f$pic_folder/${rfile}\n"
    done | rofi -dmenu -replace -config ~/.config/rofi/config-wall.rasi -p " > ")
    if [ ! "$selected" ]; then
        echo "No wallpaper selected"
        exit
    fi
    echo "Debug in --select: selected = $selected"
    wal -q -i "$pic_folder/$selected" >/dev/null 2>&1
    ;;
# Use the file they sent
"--file")
    echo "Debugin --file: 2 = $2"
    wal -q -i "$2" >/dev/null 2>&1
    ;;
# Randomly select wallpaper for everything else
*)
    wal -q -i "$pic_folder/" >/dev/null 2>&1
    ;;
esac

# -----------------------------------------------------
# Load current pywal color scheme
# -----------------------------------------------------
source /home/moosicmaan/.cache/wal/colors.sh
# source "$HOME"/.cache/wal/colors.sh
printf ':: Wallpaper for pywal: %s\n' "$wallpaper"

# -----------------------------------------------------
# Write selected wallpaper into .cache files
# -----------------------------------------------------
echo "$wallpaper" >"$cache_file"
echo "* { current-image: url(\"$wallpaper\", height); }" >"$rasi_file"

# -----------------------------------------------------
# Apply wallpaper
# -----------------------------------------------------
transition_type="random"

awww img "$wallpaper" \
    --transition-type=$transition_type

# -----------------------------------------------------
# Reload status bar with new colors
# -----------------------------------------------------
eval "$HOME/.config/.scripts/wb-launch $from_cron"

# -----------------------------------------------------
# Send notification
# -----------------------------------------------------
if [ "$1" == "--init" ]; then
    echo ":: Init"
else
    newwall=$(basename "$wallpaper")
    sleep 1
    notify-send --icon=$notify_icon "Colors and Wallpaper" "Updated with image\n$newwall"
fi

echo "DONE"
