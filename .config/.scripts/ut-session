#!/usr/bin/env bash
# =====================================================
# -----------------------------------------------------
# Return a simplified string identifing the current session
#    Jason Bradberry (2025)
# -----------------------------------------------------
# =====================================================

# -----------------------------------------------------
# Export system variables that cronie may need if
# this call is from crontab - used to find the current
# session
# -----------------------------------------------------
if [[ "$1" == "cron" ]]; then
    # Load the wayland environment so that cronie can read it
    SESSION_ENV="/tmp/cron-session.env"
    # if [[ ! -f "$SESSION_ENV" ]]; then
    #     echo ""
    #     exit 1
    #     # ~/.config/.scripts/ut-save-env
    # fi
    if [[ -f "$SESSION_ENV" ]]; then
        # shellcheck source=/tmp/cron-session.env
        source "$SESSION_ENV"
    else
        echo ""
        exit 1
    fi
fi

# -----------------------------------------------------
# Load session information from system variables
# -----------------------------------------------------
if [[ -n "$XDG_CURRENT_DESKTOP" ]]; then
    session="$XDG_CURRENT_DESKTOP"
elif [[ -n "$DESKTOP_SESSION" ]]; then
    session="$DESKTOP_SESSION"
fi

# -----------------------------------------------------
# Discover the current Wayland Compositor
# -----------------------------------------------------
case "$session" in
sway | Sway | sway:wlroots | sway\;wlroots | /usr/share/wayland-sessions/sway.desktop)
    session="sway"
    ;;
hypr | hyprland | /usr/share/wayland-sessions/hyprland-uwsm.desktop | Hyprland | hyprland-uwsm | /usr/share/wayland-sessions/hyprland.desktop)
    # echo "testing"
    # hypr)
    session="hypr"
    ;;
dwl | DWL | /usr/local/share/wayland-sessions/dwl.desktop | dwl:wlroots)
    session="dwl"
    ;;
niri | niri:wlroots | /usr/share/wayland-sessions/niri.desktop)
    session="niri"
    ;;
mango)
    session="mango"
    ;;
"")
    session=""
    ;;
*)
    session="nf"
    # exit 1
    ;;
esac

# -----------------------------------------------------
# Retorn simplified session name
# -----------------------------------------------------
echo "$session"
