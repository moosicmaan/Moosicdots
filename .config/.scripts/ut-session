#!/usr/bin/env bash
# =====================================================
# -----------------------------------------------------
# Return a simplified string identifing the current session
#    Jason Bradberry (2025)
# -----------------------------------------------------
# =====================================================

sfile="$HOME/.config/.settings/moosic-settings.json"
script_name=$(basename "$0")

# -----------------------------------------------------
# Load session information from system variables
# -----------------------------------------------------
if [[ -n "$XDG_CURRENT_DESKTOP" ]]; then
    session="$XDG_CURRENT_DESKTOP"
elif [[ -n "$DESKTOP_SESSION" ]]; then
    session="$DESKTOP_SESSION"
fi

# Testing:
# session=""
# session="BadTest"

if [[ -n "$session" ]]; then
    for i in $(jq -r '.WM | keys[]' "$sfile"); do
        key=$((i))

        wm=$(jq -r --argjson key "$key" '.WM[$key].name' "$sfile")

        for names in $(jq -r --argjson key "$key" \
            '.WM[$key].alias[]' "$sfile"); do
            if [[ "$names" == "$session" ]]; then
                session="$wm"
                wm_found=true
                break 2
            fi
        done
    done
else
    session="empty!env"
fi

# -----------------------------------------------------
# Return simplified session name if found
# -----------------------------------------------------
if [[ "$wm_found" ]]; then
    echo "$session"
else
    printf '! Error: Session not found: \"%s\"\nExiting %s...\n' \
        "$session" "$script_name"
    exit 1
fi
