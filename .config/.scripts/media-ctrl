music_icon="/usr/share/icons/Tela-circle-dracula-dark/symbolic/devices/audio-card-symbolic.svg"
music_dir="/usr/share/icons/Tela-circle-dracula-dark/symbolic/actions"

# Show the current status of the media player
show_now() {
    show_music_notification i
}

# Play the next track
play_next() {
    playerctl next
    sleep 1
    show_music_notification
    echo -n 'n' >.config/pianobar/ctl
}

# Play the previous track
play_previous() {
    playerctl previous
    sleep 1
    show_music_notification
}

# Toggle play/pause
toggle_play_pause() {
    playerctl play-pause
    sleep 1
    show_music_notification
    echo -n 'p' >.config/pianobar/ctl
}

# Stop playback
stop_playback() {
    player_name=$(playerctl metadata --format '{{uc(playerName)}}')
    music_icon="$music_dir/media-playback-stop-symbolic.svg"
    playerctl stop
    sleep 1
    notify-send -e -u low -i "$music_icon" "Playback Stopped:" "$player_name"
    echo -n 'q' >.config/pianobar/ctl
}

# Display notification with song information
show_music_notification() {
    status=$(playerctl status)
    player=$(playerctl -l | head -n 1)
    curr_file=$(realpath "$(playerctl metadata --format '{{ xesam:url }}' |
        sed 's|^file://||' | sed 's/%20/ /g')")
    curr_dir=$(dirname "$curr_file")
    case $player in
    *"spotube"*) player="Spotube" ;;
    *"mpv"*) player="MPV" ;;
    *"firefox"*) player="Zen/ff" ;;
    *) echo "player not reconized" ;;
    esac
    if [[ "$status" == "Playing" ]]; then
        song_title=$(playerctl metadata title)
        song_artist=$(playerctl metadata artist)
        song_pos=$(playerctl metadata \
            --format "$player"' [{{duration(position)}} / {{duration(mpris:length)}}]')
        music_icon="$music_dir/media-playback-start-symbolic.svg"
        if [[ "$player" == "MPV" ]]; then
            if [[ -f "/tmp/mpv-cover-art.jpg" ]]; then
                music_icon="/tmp/mpv-cover-art.jpg"
            elif [[ -f "$curr_dir/Folder.jpg" ]]; then
                music_icon="$curr_dir/Folder.jpg"
            elif [[ -f "$curr_dir/album.jpg" ]]; then
                music_icon="$curr_dir/album.jpg"
            fi
        fi
        notify-send -e -u normal -i "$music_icon" \
            "Now Playing:" "$song_title\nby $song_artist\non $song_pos"
    elif [[ "$status" == "Paused" ]]; then
        music_icon="$music_dir/media-playback-pause-symbolic.svg"
        player_name=$(playerctl metadata --format "$player")
        notify-send -e -u normal -i "$music_icon" \
            "Playback Paused:" "$player_name"
    fi
}

# Get media control action from command line argument
case "$1" in
"--nxt")
    play_next
    ;;
"--prv")
    play_previous
    ;;
"--pause")
    toggle_play_pause
    ;;
"--stop")
    stop_playback
    ;;
"--show")
    show_now
    ;;
*)
    echo "Usage: $0 [--nxt|--prv|--pause|--stop|--show]"
    exit 1
    ;;
esac
