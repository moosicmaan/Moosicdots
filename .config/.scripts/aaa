sfile="$HOME/.config/.settings/moosic-settings.json"

# session="TestincgWM"
session=
if [[ -n "$session" ]]; then
    for i in $(jq -r '.WM | keys[]' "$sfile"); do
        key=$((i))

        wm=$(jq -r --argjson key "$key" '.WM[$key].name' "$sfile")

        for names in $(jq -r --argjson key "$key" '.WM[$key].alias[]' "$sfile"); do
            if [[ "$names" == "$session" ]]; then
                # echo "Match found: $names=$session"
                session="$wm"
                # echo "Simplifying session name to: $session"
                wm_found=true
                break 2
            fi
        done
        echo "Testing: End search for $wm"
    done
else
    session="empty!env"
fi

if [[ "$wm_found" ]]; then
    echo "$session"
else
    printf 'nf%s\n' "$session"
    exit 1
fi
