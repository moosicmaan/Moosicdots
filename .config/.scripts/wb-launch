#!/usr/bin/env bash
# =====================================================
# -----------------------------------------------------
# Launch the statusbar for wayland compositors
#    Jason Bradberry (2024)
# -----------------------------------------------------
# =====================================================

cdesk="$1"
# Prefix to run commands in wayland using uwsm.
prefix=$("$HOME/.config/.scripts/wayland-prefix")
get_session="$HOME/.config/.scripts/ut-session"
themecache="$HOME/.cache/themestyle"
themedir="$HOME/.config/waybar/themes"
defaulttheme="moosic;moosic/mixed"
script_name=$(basename "$0")

# -----------------------------------------------------
# Discover the current Wayland Compositor and if this is from cronie
# -----------------------------------------------------
printf 'WB-LAUNCH______________________________________\n'
if [[ ! -n "$cdesk" ]]; then
    if ! cdesk=$("$get_session"); then
        printf 'Error getting session name. Extitng %s\n\n' "$script_name"
    fi
fi

# -----------------------------------------------------
# Quit all running statuesbar instances
# -----------------------------------------------------
pkill waybar
pkill mangobar
sleep 0.2

# -----------------------------------------------------
# Get current theme information from .cache/themestyle
# -----------------------------------------------------
if [ ! -f "$themecache" ]; then
    printf 'Theme cache file, %s, not found!\nUsing default: %s' \
        "$themecache" "$defaulttheme"
    touch "$themecache"
    echo "$defaulttheme" >"$themecache"
fi

themestyle=$(cat "$themecache")
IFS=';' read -ra arrThemes <<<"$themestyle"

printf 'Using the following to open the bar(s): %s\n' "$themestyle"
echo "* Theme: ${arrThemes[0]}"
echo "* Style: ${arrThemes[1]}"
echo "* WM/WC: $cdesk"

# -----------------------------------------------------
# Loading the configuration for Waybar
# -----------------------------------------------------
config_file="config_$cdesk.jsonc"
style_file="style.css"

cfile="$themedir/${arrThemes[0]}/$config_file"
sfile="$themedir/${arrThemes[1]}/$style_file"

printf '* Config file: %s\n* Style file: %s\n' "$cfile" "$sfile"

nfct=0
if [[ ! -f "$cfile" ]]; then
    printf '!\tConfig file not found:\n\t%s\n' "$cfile"
    ((nfct++))
fi
if [[ ! -f "$sfile" ]]; then
    printf '!\tStyle file not found:\n\t%s\n' "$sfile"
    ((nfct++))
fi

if ((nfct > 0)); then
    echo "Exiting $script_name..."
    exit 1
else
    printf ':: Starting Waybar...'

    cmd=()
    if [[ -n "$prefix" ]]; then
        read -r -a cmd <<<"$prefix"
    fi

    "${cmd[@]}" waybar -c "$cfile" -s "$sfile" \
        >/dev/null 2>&1 </dev/null &

    printf 'DONE - %s\n' "$script_name"
fi
