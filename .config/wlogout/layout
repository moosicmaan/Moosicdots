{
   "label" : "lock",
   "action" : "sleep 1; pkill hyprlock; hyprlock -c /home/moosicmaan/.config/hypr/C/options/hyprlock.conf",
   "text" : "Lock",
   "keybind" : "l"
}
{
    "label" : "hibernate",
    "action" : "sleep 1; systemctl hibernate",
    "text" : "Hibernate",
    "keybind" : "h"
}
{
    "label" : "logout",
    "action" : "loginctl terminate-session $XDG_SESSION_ID",
    "text" : "Exit",
    "keybind" : "e"
}
{
    "label" : "shutdown",
    "action" : "sleep 1; systemctl poweroff",
    "text" : "Shutdown",
    "keybind" : "s"
}
{
    "label" : "suspend",
    "action" : "sleep 1; systemctl suspend",
    "text" : "Suspend",
    "keybind" : "u"
}
{
    "label" : "reboot",
    "action" : "sleep 1; systemctl reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
